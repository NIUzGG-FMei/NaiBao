<Window x:Class="Naibao.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="naibao"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">
    <Grid Background="Transparent">
        <Image x:Name="PetImage"
               Width="160"
               Height="160"
               Source="assets/naibao.png"
               Stretch="Uniform"
               Cursor="Hand"
               RenderOptions.BitmapScalingMode="HighQuality"
               MouseLeftButtonDown="PetImage_MouseLeftButtonDown"
               MouseMove="PetImage_MouseMove"
               MouseLeftButtonUp="PetImage_MouseLeftButtonUp"
               MouseRightButtonDown="PetImage_MouseRightButtonDown"
               MouseRightButtonUp="PetImage_MouseRightButtonUp"/>

        <!-- 右键弹出：动漫风泡泡菜单，定位在宠物头顶，不遮挡宠物 -->
        <Popup x:Name="MenuPopup"
               AllowsTransparency="True"
               StaysOpen="False"
               PopupAnimation="Fade"
               PlacementTarget="{Binding ElementName=PetImage}"
               CustomPopupPlacementCallback="PlaceMenuPopup">
            <Grid Width="260">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        CornerRadius="20"
                        BorderBrush="#FFFFB7D9"
                        BorderThickness="2"
                        Padding="14,12">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFFFFBFF" Offset="0"/>
                            <GradientStop Color="#FFFFE3F2" Offset="0.55"/>
                            <GradientStop Color="#FFFFCFE9" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.30"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="🐾 naibao"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#FFB0528E"
                                   Margin="2,0,0,6"/>
                        <Button x:Name="WebJumpButton"
                                Content="🌐 网页跳转 ▾"
                                Style="{StaticResource BubbleButtonStyle}"
                                Click="WebJumpButton_Click"/>
                        <ItemsControl x:Name="WebLinkList"
                                      Visibility="Collapsed"
                                      Margin="12,0,0,4"/>
                        <Button Content="✂️ 截图"
                                Style="{StaticResource BubbleButtonStyle}"
                                Click="ScreenshotButton_Click"/>
                        <Button Content="⚙️ 设置"
                                Style="{StaticResource BubbleButtonStyle}"
                                Click="SettingsButton_Click"/>
                        <Button Content="🙈 隐藏起来"
                                Style="{StaticResource BubbleButtonStyle}"
                                Click="HideButton_Click"/>
                        <Button Content="👋 退出"
                                Style="{StaticResource BubbleButtonStyle}"
                                Foreground="#FFC94F7D"
                                Click="ExitButton_Click"/>
                    </StackPanel>
                </Border>

                <Path Grid.Row="1"
                      HorizontalAlignment="Center"
                      Margin="0,-1,0,0"
                      Data="M 0,0 L 18,0 L 9,10 Z"
                      Fill="#FFFFD1EA"
                      Stroke="#FFFFB7D9"
                      StrokeThickness="2"/>
            </Grid>
        </Popup>

        <Popup x:Name="ChimePopup"
               AllowsTransparency="True"
               StaysOpen="False"
               PopupAnimation="Fade"
               PlacementTarget="{Binding ElementName=PetImage}"
               CustomPopupPlacementCallback="PlaceChimePopup">
            <Border Background="#F8FFFFFF"
                    BorderBrush="#FFD9A441"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14,10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.35"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="整点报时"
                               FontWeight="Bold"
                               FontSize="12"
                               Foreground="#FF8A5A00"
                               Margin="0,0,0,4"/>
                    <TextBlock x:Name="ChimeText"
                               Text=""
                               TextWrapping="Wrap"
                               MaxWidth="230"
                               FontSize="14"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
