<Window x:Class="Naibao.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="naibao"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">
    <Grid Background="Transparent">
        <Image x:Name="PetImage"
               Width="160"
               Height="160"
               Source="assets/naibao.png"
               Stretch="Uniform"
               Cursor="Hand"
               RenderOptions.BitmapScalingMode="HighQuality"
               MouseLeftButtonDown="PetImage_MouseLeftButtonDown"
               MouseMove="PetImage_MouseMove"
               MouseLeftButtonUp="PetImage_MouseLeftButtonUp">
            <Image.ContextMenu>
                <ContextMenu x:Name="PetMenu"
                             StaysOpen="False"
                             Padding="4"
                             Background="#F8FFFFFF"
                             BorderBrush="#FFCFCFCF"
                             BorderThickness="1"
                             Opened="PetMenu_Opened">
                    <ContextMenu.Resources>
                        <Style TargetType="MenuItem">
                            <Setter Property="Padding" Value="12,5"/>
                        </Style>
                    </ContextMenu.Resources>
                    <MenuItem x:Name="WebJumpMenuItem" Header="网页跳转"/>
                    <MenuItem Header="截图" Click="ScreenshotItem_Click"/>
                    <Separator/>
                    <MenuItem Header="设置" Click="SettingsItem_Click"/>
                    <MenuItem Header="隐藏" Click="HideItem_Click"/>
                    <Separator/>
                    <MenuItem Header="退出" Click="ExitItem_Click"/>
                </ContextMenu>
            </Image.ContextMenu>
        </Image>

        <Popup x:Name="ChimePopup"
               AllowsTransparency="True"
               StaysOpen="False"
               PopupAnimation="Fade"
               PlacementTarget="{Binding ElementName=PetImage}"
               CustomPopupPlacementCallback="PlaceChimePopup">
            <Border Background="#F8FFFFFF"
                    BorderBrush="#FFD9A441"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14,10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.35"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="整点报时"
                               FontWeight="Bold"
                               FontSize="12"
                               Foreground="#FF8A5A00"
                               Margin="0,0,0,4"/>
                    <TextBlock x:Name="ChimeText"
                               Text=""
                               TextWrapping="Wrap"
                               MaxWidth="230"
                               FontSize="14"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
